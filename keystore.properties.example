# Release imzası için örnek yapılandırma.
# `tools/make-keystore.sh` çalıştırıldığında keystore.properties otomatik
# oluşturulur; bu dosya yalnızca kendi anahtarınızı bağlamak içindir.
# keystore.properties git'e eklenmez.
storeFile=/home/kullanici/.android-keys/novatv.jks
storePassword=degistir
keyAlias=novatv
keyPassword=degistir
